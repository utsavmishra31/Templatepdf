{
  "name": "translation_generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:pdf-parser": "rm -rf src/pdf/tests/parser/.out && tsc -p src/pdf/tests/parser/tsconfig.tests.json && node --test src/pdf/tests/parser/.out/pdf/tests/parser/unit/parser.unit.test.js src/pdf/tests/parser/.out/pdf/tests/parser/unit/parser.edge-cases.test.js src/pdf/tests/parser/.out/pdf/tests/parser/integration/parser.integration.test.js",
    "test:pdf-content": "rm -rf src/pdf/tests/content/.out && npx tsc -p src/pdf/tests/content/tsconfig.tests.json && node --test src/pdf/tests/content/.out/tests/content/unit/ContentLexer.test.js src/pdf/tests/content/.out/tests/content/unit/ContentParser.test.js src/pdf/tests/content/.out/tests/content/unit/TextExtractor.test.js src/pdf/tests/content/.out/tests/content/integration/ContentStream.integration.test.js src/pdf/tests/content/.out/tests/content/edge-cases/parser.edge-cases.test.js",
    "bench:pdf-parser": "tsc -p src/pdf/tests/parser/tsconfig.tests.json && node src/pdf/tests/parser/.out/pdf/tests/parser/benchmark/parser.benchmark.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "docx-preview": "^0.3.7",
    "html2pdf.js": "^0.10.3",
    "jszip": "^3.10.1",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.7.2"
  }
}
