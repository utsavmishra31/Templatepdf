# ─────────────────────────────────────────────────────────
# ONLYOFFICE Document Server
# ─────────────────────────────────────────────────────────

# URL of your ONLYOFFICE Docs server.
# Local Docker:  http://localhost  (default port 80)
# Production:    https://docs.yourdomain.com
NEXT_PUBLIC_ONLYOFFICE_SERVER_URL=http://localhost

# ─────────────────────────────────────────────────────────
# App public URL
# ─────────────────────────────────────────────────────────

# The URL this Next.js app is reachable at FROM the ONLYOFFICE server.
# ONLYOFFICE calls /api/files/:key  and  /api/callback?key=:key
#
# Local Docker:  ONLYOFFICE can't reach localhost, use the Docker host:
#   Mac / Windows  →  http://host.docker.internal:3000
#   Linux          →  http://172.17.0.1:3000   (check: docker network inspect bridge)
#
# Production:    https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://host.docker.internal:3000
